# Nebius Token Factory / NVIDIA Nemotron Configuration
NEBIUS_API_KEY=replace_with_your_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional API Host & Port configuration
PROMPTGUARD_API_URL=http://127.0.0.1:8000

# Optional API bearer token. Set the same value in the dashboard and backend environment.
PROMPTGUARD_API_KEY=

# JSON list of trusted browser frontend origins.
CORS_ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# Keep disabled for normal fail-closed operation. Enable only for local offline demos.
ENABLE_MOCK_FALLBACK=false
